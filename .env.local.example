# Copy to .env.local and fill in. Never commit real keys.

# --- ElevenLabs (required for listening + speaking) ---
# Your permanent ElevenLabs API key. Stays server-side only.
ELEVENLABS_API_KEY=

# Optional: a preselected voice id for spoken prompts.
# Defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM) if unset.
ELEVENLABS_VOICE_ID=

# --- Open-weight coach model (optional; P1 "Explain") ---
# Defaults to Google Gemma 4 via the Gemini API's OpenAI-compatible endpoint.
# Get a key at https://aistudio.google.com/apikey and set COACH_API_KEY.
COACH_API_KEY=
# Model id. Default "gemma-4-26b-a4b-it" (fast MoE); or "gemma-4-31b-it".
COACH_MODEL=gemma-4-26b-a4b-it
# Only to point at a different OpenAI-compatible endpoint (e.g. a local
# runtime like Ollama / vLLM / LM Studio). Leave blank to use Google Gemma.
COACH_API_URL=
# With no COACH_API_KEY and no COACH_API_URL, Explain uses reviewed fallbacks.
